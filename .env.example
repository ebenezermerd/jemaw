# ─── Phase 0 (required) ───────────────────────────────────────────────
# Local Postgres started by docker-compose.yml
DATABASE_URL=postgres://jemaw:jemaw@localhost:5432/jemaw

# From @BotFather. Required for the bot to talk to Telegram.
TELEGRAM_BOT_TOKEN=

# "polling" for local dev (no public URL needed), "webhook" for prod.
BOT_MODE=polling

# Only required when BOT_MODE=webhook. Public HTTPS base URL of the bot.
# WEBHOOK_URL=https://jemaw-bot.fly.dev

# Fastify listen port.
PORT=8080

# NODE_ENV: development | production
NODE_ENV=development

# Base URL of the deployed Mini App (used for buttons). Placeholder in Phase 0.
MINI_APP_URL=http://localhost:5173

# ─── App (Vite) ───────────────────────────────────────────────────────
# Where the SPA calls the bot API.
VITE_API_BASE_URL=http://localhost:8080

# ─── Future phases (NOT required in Phase 0) ──────────────────────────
# GEMINI_API_KEY=          # Phase 3 — Gemini scan loop
# REDIS_URL=               # Phase 3 — bullmq queue (Upstash)
# SENTRY_DSN=              # Monitoring
