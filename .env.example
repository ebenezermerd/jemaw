# ─── Phase 0 (required) ───────────────────────────────────────────────
# Local Postgres started by docker-compose.yml
DATABASE_URL=postgres://jemaw:jemaw@localhost:5432/jemaw

# From @BotFather. Required for the bot to talk to Telegram.
TELEGRAM_BOT_TOKEN=

# "polling" for local dev (no public URL needed), "webhook" for prod.
BOT_MODE=polling

# Only required when BOT_MODE=webhook. Public HTTPS base URL of the bot.
# WEBHOOK_URL=https://jemaw-bot.fly.dev

# Fastify listen port.
PORT=8080

# NODE_ENV: development | production
NODE_ENV=development

# Base URL of the deployed Mini App (used for buttons). Placeholder in Phase 0.
MINI_APP_URL=http://localhost:5173

# ─── App (Vite) ───────────────────────────────────────────────────────
# Where the SPA calls the bot API.
VITE_API_BASE_URL=http://localhost:8080

# ─── Admin API (@jemaw/api) ───────────────────────────────────────────
# The admin API reads PORT for its own process (default 8090). Run it with a
# distinct PORT from the bot when both run locally, e.g. PORT=8090 pnpm dev:api.
# Firebase project id used to verify admin ID tokens (same Firebase project).
FIREBASE_PROJECT_ID=jemaw-498106
# Comma-separated emails seeded as console admins on first boot.
ADMIN_EMAILS=admin@jemaw.et
# Allowed CORS origin for the admin SPA.
ADMIN_ORIGIN=http://localhost:5174

# ─── Admin SPA (@jemaw/admin, Vite) ───────────────────────────────────
# The admin SPA reuses VITE_API_BASE_URL; point it at the admin API in prod.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=jemaw-498106.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jemaw-498106
VITE_FIREBASE_APP_ID=

# ─── Future phases (NOT required in Phase 0) ──────────────────────────
# GEMINI_API_KEY=          # Phase 3 — Gemini scan loop
# REDIS_URL=               # Phase 3 — bullmq queue (Upstash)
# SENTRY_DSN=              # Monitoring
