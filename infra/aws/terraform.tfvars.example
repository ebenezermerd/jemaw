aws_region         = "eu-north-1"
project_name       = "jemaw"
environment        = "prod"
image_tag          = "latest"
allowed_admin_cidr = "203.0.113.10/32"

telegram_bot_token  = "123456:replace-me"
# Leave AI keys empty here. Set them only in AWS Secrets Manager:
#   ./scripts/aws-set-ai-keys.sh --prompt
gemini_api_key      = ""
groq_api_key        = ""
# Model ids (non-secret). Match packages/bot DEFAULT_* when empty in the app.
groq_model          = "openai/gpt-oss-120b"
gemini_model        = "gemini-2.5-flash-lite"
bot_username        = "jemawsbot"
mini_app_short_name = "app"
